# ============================================================
# ChangeImpact AI — Root .gitignore
# ============================================================

# Environment variables & secrets (CRITICAL)
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.pfx

# Backend (Java / Maven)
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
logs/
backend/logs/
*.log
.attach_pid*
hs_err_pid*

# Frontend (Node / React / Vite)
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Indexing & Ingestion Workspaces
workspaces/
temp/
tmp/

# IDEs & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
.classpath
.project
.settings/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Agent / Tool cache
.gemini/
*.exe
