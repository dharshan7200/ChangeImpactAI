# ChangeImpact AI web server: serves the SPA and proxies the API (same origin, no CORS needed).
# Environment (nginx image envsubst): BACKEND_UPSTREAM (host:port), CLIENT_MAX_BODY_SIZE.
server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};   # CI report uploads (backend limit: 55 MB)

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # fingerprinted build output: cache forever
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # client-side routes fall back to the app shell, which is never cached
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
