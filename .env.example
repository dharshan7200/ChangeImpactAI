# ============================================================
# ChangeImpact AI — Environment Configuration Template
# Copy this file to .env and fill in required secrets.
# Never commit .env with real secrets to version control.
# ============================================================

# ---- Server ----
SERVER_PORT=8080
APP_PROFILE=dev

# ---- Database (PostgreSQL + pgvector) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=changeimpact
DB_USERNAME=changeimpact
DB_PASSWORD=changeimpact

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- RabbitMQ ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ---- Security & JWT ----
# Generate with: openssl rand -base64 32
JWT_SECRET=c29tZS1zZWN1cmUtand0LXNlY3JldC1rZXktZm9yLWRldmVsb3BtZW50LW9ubHk=
JWT_ACCESS_EXPIRY_MS=900000

JWT_REFRESH_EXPIRY_MS=604800000
BCRYPT_STRENGTH=12

# ---- Encryption Key (AES-256-GCM) ----
# 32-byte Base64-encoded string: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=DV3Paxg2A3dr4hl62xaNGxwG+gv38pPQiOEuvBOLcdI=

# ---- AI Engine (OpenAI / Gemini) ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- GitHub Integration ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

