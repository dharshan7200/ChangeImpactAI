# ============================================================
# ChangeImpact AI — environment template for docker-compose.full.yml
# ============================================================
#   ./scripts/generate-env.sh      # writes .env from this file with fresh random secrets
#   (or: cp .env.example .env and fill in every REQUIRED value by hand)
#
# Never commit .env. Values left empty below are REQUIRED: docker compose refuses to start
# without them, and the backend (prod profile) refuses to start with weak or development values.
# Local development (docker-compose.yml + mvn spring-boot:run) needs no .env: application.yml has dev defaults.
# Full variable reference: docs/CONFIGURATION.md
# ============================================================

# ---- Public URL -------------------------------------------------------------
# REQUIRED. URL users open in the browser (used for CORS, links in reports and PR comments).
FRONTEND_URL=http://localhost:8088
# Defaults to FRONTEND_URL.
CHANGEIMPACT_PUBLIC_URL=

# ---- Web port ---------------------------------------------------------------
# Only this port is published. Put a TLS-terminating reverse proxy in front of it for anything public.
HTTP_BIND=0.0.0.0
HTTP_PORT=8088

# ---- Secrets (REQUIRED) -----------------------------------------------------
# PostgreSQL password.                       openssl rand -base64 24
DB_PASSWORD=
# RabbitMQ credentials (anything but guest/guest).
RABBITMQ_USERNAME=changeimpact
RABBITMQ_PASSWORD=
# Redis password.
REDIS_PASSWORD=
# JWT signing key, at least 32 bytes.        openssl rand -base64 48
JWT_SECRET=
# AES-256-GCM key for stored GitHub tokens: exactly 32 bytes, Base64.   openssl rand -base64 32
# Keep a copy in your secret store: losing it makes stored GitHub tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# ---- Accounts -------------------------------------------------------------
# Comma-separated e-mails that get the ADMIN role on registration/login.
ADMIN_EMAILS=
BCRYPT_STRENGTH=12

# ---- Repository access ----------------------------------------------------
# Hosts repositories may be cloned from (comma-separated).
ALLOWED_GIT_HOSTS=github.com

# ---- Jobs -----------------------------------------------------------------
MAX_CONCURRENT_JOBS=3
# Memory limit of the backend container; the JVM uses 75 % of it.
BACKEND_MEMORY_LIMIT=4g
# Languages analysed. "all" = Java, Python, JavaScript/TypeScript (incl. React JSX/TSX), PHP, C#, Go, Ruby, HTML
# templates, CSS and SQL. Or a list ("java,python,javascript"); "-name" removes one ("all,-sql"). Java is always on.
# See docs/MULTI_LANGUAGE.md.
ANALYSIS_LANGUAGES=all
# Dependency jars of analysed Java projects (Maven/Gradle builds) for type resolution; read, never executed.
# Needs outbound access to LIBRARY_REPOSITORY_URL (Maven Central by default). false = library calls stay UNRESOLVED.
LIBRARY_RESOLUTION_ENABLED=true
LIBRARY_REPOSITORY_URL=https://repo.maven.apache.org/maven2
# Build the backend image with the Semgrep CLI (security scanning of changed files). false = smaller image.
INSTALL_SEMGREP=true

# ---- GitHub OAuth App (optional: "Connect with GitHub" for private repositories) ----
# Register at GitHub → Settings → Developer settings → OAuth Apps, callback URL = <FRONTEND_URL>/github/oauth/callback.
# Without it, users connect GitHub with a personal access token instead.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GitHub Enterprise only: https://<your-ghe-host> (the API URL is GITHUB_API_BASE_URL below)
GITHUB_WEB_BASE_URL=https://github.com

# ---- GitHub App (optional: automatic pull-request analysis + Check Runs) -----
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
# PEM contents (newlines as \n) — required when GITHUB_APP_ID is set.
GITHUB_APP_PRIVATE_KEY=
# Required when the GitHub App is configured.   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# ---- AI review, assistant and code search (optional: Google Gemini) ----------
# Without a key the AI features are off; every deterministic analysis still runs. docs/AI_REVIEW.md
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-3.5-flash
# Used when the chat model is overloaded (503/429) after a retry.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Embedding texts per minute the server sends (Gemini free tier: 100). Raise it on a paid plan to index faster.
GEMINI_EMBED_PER_MINUTE=100

# ---- Observability (optional) ---------------------------------------------
# Bearer token Prometheus uses for /actuator/prometheus (>= 24 chars). Required for --profile monitoring.
METRICS_SCRAPE_TOKEN=
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces

# ---- Images ---------------------------------------------------------------
IMAGE_PREFIX=changeimpact
IMAGE_TAG=latest
